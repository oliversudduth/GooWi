{
  "manifest_version": 3,
  "name": "GooWi",
  "version": "0.8.0",
  "description": "Brings relevant Wikipedia beside Google Search and opens GooWi on selected text anywhere in the browser, with reading mode, Random Article, and Wikirace.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "goowi@oliversudduth.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms",
          "websiteContent"
        ]
      }
    }
  },
  "host_permissions": [
    "https://*.wikipedia.org/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "googlepedia.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "developer": {
    "name": "Oliver Sudduth",
    "url": "https://oliversudduth.com/"
  },
  "homepage_url": "https://github.com/oliversudduth/GooWi",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ]
}
